{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out",
    "rootDir": "src",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "composite": true, // Add for composite projects
    "declaration": true, // Add for composite projects
    "declarationMap": true, // Useful for debugging
    "sourceMap": true // Already in base, but ensure it's effectively true
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"],
  "references": []
}
